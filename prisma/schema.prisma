generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum OrderStatus {
  NEW
  PREPARING
  READY
  SERVED
  PAID
  CANCELLED
  ON_HOLD
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum PaymentMethod {
  CASH
  CARD
  WALLET
  SPLIT
  GATEWAY
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  CLEANING
  OUT_OF_SERVICE
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  SEATED
  CANCELLED
}

enum KitchenTicketStatus {
  QUEUED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum StockMovementType {
  PURCHASE
  SALE_DEDUCTION
  MANUAL_ADJUSTMENT
  WASTAGE
  TRANSFER
  STOCK_TAKE
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum CashDrawerStatus {
  OPEN
  CLOSED
  RECONCILED
}

enum LoyaltyTxType {
  EARN
  REDEEM
  ADJUST
  EXPIRE
}

// ==========================================
// CORE: BRANCHES & SETTINGS
// ==========================================

model Branch {
  id                  String   @id @default(uuid())
  name                String
  code                String   @unique
  address             String
  phone               String
  email               String?
  currency            String   @default("USD")
  timezone            String   @default("UTC")
  taxRatePercent      Decimal  @default(10.0) @db.Decimal(5, 2)
  serviceChargePercent Decimal @default(5.0) @db.Decimal(5, 2)
  orderNumberPrefix   String   @default("ORD")
  receiptHeader       String?
  receiptFooter       String?
  businessHours       Json?    // { monday: { open: "09:00", close: "22:00" }, ... }
  isActive            Boolean  @default(true)
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  users               User[]
  categories          Category[]
  menuItems           MenuItem[]
  combos              Combo[]
  floors              Floor[]
  tables              Table[]
  reservations        Reservation[]
  waitlists           Waitlist[]
  orders              Order[]
  kitchenTickets      KitchenTicket[]
  payments            Payment[]
  taxRates            TaxRate[]
  discounts           Discount[]
  coupons             Coupon[]
  customers           Customer[]
  ingredients         Ingredient[]
  suppliers           Supplier[]
  purchaseOrders      PurchaseOrder[]
  employees           Employee[]
  expenseCategories   ExpenseCategory[]
  expenses            Expense[]
  cashDrawerSessions  CashDrawerSession[]
  deliveryZones       DeliveryZone[]
  riders              Rider[]
  notifications       Notification[]
  auditLogs           AuditLog[]
  settings            Setting[]

  @@index([isActive])
  @@index([createdAt])
}

model Setting {
  id        String   @id @default(uuid())
  branchId  String
  key       String
  value     Json
  group     String   @default("GENERAL")
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, key])
  @@index([branchId])
}

// ==========================================
// AUTH, USERS, ROLES & PERMISSIONS
// ==========================================

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  slug        String           @unique
  description String?
  isSystem    Boolean          @default(false)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?

  users       User[]
  permissions RolePermission[]

  @@index([slug])
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique // e.g., "orders.create", "orders.refund"
  module      String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  roles       RolePermission[]

  @@index([module])
  @@index([key])
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
}

model User {
  id                  String         @id @default(uuid())
  branchId            String?
  roleId              String
  email               String         @unique
  passwordHash        String
  firstName           String
  lastName            String
  phone               String?
  avatarUrl           String?
  pinCode             String?
  isActive            Boolean        @default(true)
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  passwordResetToken  String?
  passwordResetExpires DateTime?
  notificationPrefs   Json?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  branch              Branch?        @relation(fields: [branchId], references: [id])
  role                Role           @relation(fields: [roleId], references: [id])
  refreshTokens       RefreshToken[]
  employee            Employee?
  ordersWaiter        Order[]        @relation("WaiterOrders")
  ordersCashier       Order[]        @relation("CashierOrders")
  notifications       Notification[]
  auditLogs           AuditLog[]

  @@index([branchId])
  @@index([roleId])
  @@index([email])
  @@index([isActive])
  @@index([createdAt])
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  tokenHash   String    @unique
  familyId    String
  userAgent   String?
  ipAddress   String?
  expiresAt   DateTime
  revokedAt   DateTime?
  replacedBy  String?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  branchId   String?
  userId     String?
  action     String   // e.g., "AUTH_LOGIN", "ORDER_REFUND", "PRICE_CHANGE", "ROLE_UPDATE"
  entity     String   // e.g., "Order", "MenuItem", "User"
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())

  branch     Branch?  @relation(fields: [branchId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([branchId])
  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
}

// ==========================================
// MENU: CATEGORIES, ITEMS, VARIANTS, ADDONS, COMBOS
// ==========================================

model Category {
  id          String     @id @default(uuid())
  branchId    String
  name        String
  slug        String
  description String?
  imageUrl    String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  branch      Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItems   MenuItem[]

  @@unique([branchId, slug])
  @@index([branchId])
  @@index([isActive])
}

model MenuItem {
  id              String        @id @default(uuid())
  branchId        String
  categoryId      String
  sku             String
  name            String
  description     String?
  price           Decimal       @db.Decimal(10, 2)
  costPrice       Decimal       @default(0) @db.Decimal(10, 2)
  imageUrl        String?
  station         String        @default("MAIN_KITCHEN") // e.g., MAIN_KITCHEN, GRILL, BAR, DESSERT
  prepTimeMinutes Int           @default(15)
  calories        Int?
  isVegetarian    Boolean       @default(false)
  isVegan         Boolean       @default(false)
  isGlutenFree    Boolean       @default(false)
  isAvailable     Boolean       @default(true)
  daypartSchedule Json?         // { breakfast: true, lunch: true, dinner: true, startTime: "06:00", endTime: "23:00" }
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?

  branch          Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category        Category      @relation(fields: [categoryId], references: [id])
  variants        ItemVariant[]
  addOns          AddOn[]
  comboItems      ComboItem[]
  orderItems      OrderItem[]
  recipe          Recipe?

  @@unique([branchId, sku])
  @@index([branchId])
  @@index([categoryId])
  @@index([sku])
  @@index([isAvailable])
  @@index([createdAt])
}

model ItemVariant {
  id         String   @id @default(uuid())
  menuItemId String
  name       String   // e.g., "Regular", "Large"
  sku        String
  priceDelta Decimal  @default(0) @db.Decimal(10, 2)
  isDefault  Boolean  @default(false)
  isAvailable Boolean @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([menuItemId])
  @@index([sku])
}

model AddOn {
  id          String   @id @default(uuid())
  menuItemId  String
  name        String   // e.g., "Extra Cheese", "Bacon"
  price       Decimal  @db.Decimal(10, 2)
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  menuItem    MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  modifiers   OrderItemModifier[]

  @@index([menuItemId])
}

model Combo {
  id          String      @id @default(uuid())
  branchId    String
  sku         String
  name        String
  description String?
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?
  isAvailable Boolean     @default(true)
  startDate   DateTime?
  endDate     DateTime?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  branch      Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  items       ComboItem[]

  @@unique([branchId, sku])
  @@index([branchId])
  @@index([sku])
}

model ComboItem {
  id         String   @id @default(uuid())
  comboId    String
  menuItemId String
  quantity   Int      @default(1)

  combo      Combo    @relation(fields: [comboId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([comboId])
  @@index([menuItemId])
}

// ==========================================
// TABLES, FLOORS, RESERVATIONS & WAITLIST
// ==========================================

model Floor {
  id          String   @id @default(uuid())
  branchId    String
  name        String
  floorNumber Int      @default(1)
  isActive    Boolean  @default(true)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  tables      Table[]

  @@index([branchId])
}

model Table {
  id           String        @id @default(uuid())
  branchId     String
  floorId      String
  tableNumber  String
  capacity     Int           @default(4)
  status       TableStatus   @default(AVAILABLE)
  shape        String        @default("RECTANGLE") // RECTANGLE, CIRCLE, SQUARE
  posX         Float         @default(0)
  posY         Float         @default(0)
  width        Float         @default(100)
  height       Float         @default(100)
  qrCodeUrl    String?
  isActive     Boolean       @default(true)
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  floor        Floor         @relation(fields: [floorId], references: [id], onDelete: Cascade)
  reservations Reservation[]
  orders       Order[]

  @@unique([branchId, tableNumber])
  @@index([branchId])
  @@index([floorId])
  @@index([status])
}

model Reservation {
  id              String            @id @default(uuid())
  branchId        String
  tableId         String
  customerId      String?
  guestName       String
  guestPhone      String
  guestEmail      String?
  partySize       Int
  reservationTime DateTime
  durationMinutes Int               @default(90)
  status          ReservationStatus @default(CONFIRMED)
  specialRequests String?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table           Table             @relation(fields: [tableId], references: [id])
  customer        Customer?         @relation(fields: [customerId], references: [id])

  @@index([branchId])
  @@index([tableId])
  @@index([customerId])
  @@index([status])
  @@index([reservationTime])
}

model Waitlist {
  id                  String         @id @default(uuid())
  branchId            String
  guestName           String
  guestPhone          String
  partySize           Int
  estimatedWaitMinutes Int           @default(15)
  status              WaitlistStatus @default(WAITING)
  notes               String?
  seatedAt            DateTime?
  createdBy           String?
  updatedBy           String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  deletedAt           DateTime?

  branch              Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([status])
  @@index([createdAt])
}

// ==========================================
// ORDERS, KITCHEN TICKETS, BILLING & PAYMENTS
// ==========================================

model Order {
  id              String          @id @default(uuid())
  branchId        String
  orderNumber     String          @unique
  tableId         String?
  customerId      String?
  waiterId        String?
  cashierId       String?
  parentOrderId   String?         // For split bills
  orderType       OrderType       @default(DINE_IN)
  status          OrderStatus     @default(NEW)
  guestCount      Int             @default(1)
  subtotal        Decimal         @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount       Decimal         @default(0) @db.Decimal(12, 2)
  serviceCharge   Decimal         @default(0) @db.Decimal(12, 2)
  deliveryFee     Decimal         @default(0) @db.Decimal(12, 2)
  tipAmount       Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal         @default(0) @db.Decimal(12, 2)
  paidAmount      Decimal         @default(0) @db.Decimal(12, 2)
  couponCode      String?
  discountId      String?
  notes           String?
  cancelReason    String?
  stockDeducted   Boolean         @default(false)
  heldAt          DateTime?
  completedAt     DateTime?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?

  branch          Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  table           Table?          @relation(fields: [tableId], references: [id])
  customer        Customer?       @relation(fields: [customerId], references: [id])
  waiter          User?           @relation("WaiterOrders", fields: [waiterId], references: [id])
  cashier         User?           @relation("CashierOrders", fields: [cashierId], references: [id])
  discount        Discount?       @relation(fields: [discountId], references: [id])
  items           OrderItem[]
  kitchenTickets  KitchenTicket[]
  payments        Payment[]
  invoice         Invoice?
  delivery        Delivery?
  feedbacks       Feedback[]

  @@index([branchId])
  @@index([orderNumber])
  @@index([tableId])
  @@index([customerId])
  @@index([waiterId])
  @@index([status])
  @@index([orderType])
  @@index([createdAt])
}

model OrderItem {
  id          String              @id @default(uuid())
  orderId     String
  menuItemId  String
  variantId   String?
  itemName    String
  variantName String?
  quantity    Int                 @default(1)
  unitPrice   Decimal             @db.Decimal(10, 2)
  subtotal    Decimal             @db.Decimal(10, 2)
  notes       String?
  status      KitchenTicketStatus @default(QUEUED)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  order       Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem    MenuItem            @relation(fields: [menuItemId], references: [id])
  variant     ItemVariant?        @relation(fields: [variantId], references: [id])
  modifiers   OrderItemModifier[]

  @@index([orderId])
  @@index([menuItemId])
  @@index([status])
}

model OrderItemModifier {
  id          String    @id @default(uuid())
  orderItemId String
  addOnId     String
  name        String
  price       Decimal   @db.Decimal(10, 2)
  quantity    Int       @default(1)

  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addOn       AddOn     @relation(fields: [addOnId], references: [id])

  @@index([orderItemId])
  @@index([addOnId])
}

model KitchenTicket {
  id               String              @id @default(uuid())
  branchId         String
  orderId          String
  ticketNumber     String
  station          String              @default("MAIN_KITCHEN")
  status           KitchenTicketStatus @default(QUEUED)
  itemsSnapshot    Json                // Array of order items routed to this station
  prepTimeTargetMin Int                @default(15)
  startedAt        DateTime?
  readyAt          DateTime?
  servedAt         DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  branch           Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  order            Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([orderId])
  @@index([station])
  @@index([status])
  @@index([createdAt])
}

model Payment {
  id                 String        @id @default(uuid())
  branchId           String
  orderId            String
  cashDrawerSessionId String?
  idempotencyKey     String        @unique
  method             PaymentMethod
  status             PaymentStatus @default(COMPLETED)
  amount             Decimal       @db.Decimal(12, 2)
  tipAmount          Decimal       @default(0) @db.Decimal(10, 2)
  tenderedAmount     Decimal?      @db.Decimal(12, 2)
  changeAmount       Decimal?      @db.Decimal(12, 2)
  transactionRef     String?
  gatewayProvider    String?
  gatewayResponse    Json?
  paidAt             DateTime      @default(now())
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  branch             Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  order              Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  cashDrawerSession  CashDrawerSession? @relation(fields: [cashDrawerSessionId], references: [id])
  refunds            Refund[]

  @@index([branchId])
  @@index([orderId])
  @@index([status])
  @@index([method])
  @@index([createdAt])
}

model Refund {
  id         String   @id @default(uuid())
  paymentId  String
  orderId    String
  amount     Decimal  @db.Decimal(12, 2)
  reason     String
  approvedBy String?
  createdBy  String?
  createdAt  DateTime @default(now())

  payment    Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@index([orderId])
  @@index([createdAt])
}

model Invoice {
  id            String   @id @default(uuid())
  orderId       String   @unique
  invoiceNumber String   @unique
  pdfUrl        String?
  issuedAt      DateTime @default(now())
  createdAt     DateTime @default(now())

  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([invoiceNumber])
  @@index([issuedAt])
}

model TaxRate {
  id          String   @id @default(uuid())
  branchId    String
  name        String   // e.g., "VAT", "GST"
  ratePercent Decimal  @db.Decimal(5, 2)
  isInclusive Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
}

model Discount {
  id             String       @id @default(uuid())
  branchId       String
  name           String
  type           DiscountType
  value          Decimal      @db.Decimal(10, 2)
  minOrderAmount Decimal      @default(0) @db.Decimal(10, 2)
  maxDiscount    Decimal?     @db.Decimal(10, 2)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders         Order[]

  @@index([branchId])
}

model Coupon {
  id             String       @id @default(uuid())
  branchId       String
  code           String
  description    String?
  type           DiscountType
  value          Decimal      @db.Decimal(10, 2)
  minOrderAmount Decimal      @default(0) @db.Decimal(10, 2)
  maxDiscount    Decimal?     @db.Decimal(10, 2)
  usageLimit     Int?
  usedCount      Int          @default(0)
  startsAt       DateTime?
  expiresAt      DateTime?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?

  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, code])
  @@index([branchId])
  @@index([code])
}

model CashDrawerSession {
  id               String           @id @default(uuid())
  branchId         String
  openedByUserId   String
  closedByUserId   String?
  openingBalance   Decimal          @db.Decimal(12, 2)
  expectedBalance  Decimal          @default(0) @db.Decimal(12, 2)
  closingBalance   Decimal?         @db.Decimal(12, 2)
  discrepancy      Decimal?         @db.Decimal(12, 2)
  status           CashDrawerStatus @default(OPEN)
  notes            String?
  openedAt         DateTime         @default(now())
  closedAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  branch           Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  payments         Payment[]

  @@index([branchId])
  @@index([status])
  @@index([openedAt])
}

// ==========================================
// CUSTOMERS, LOYALTY & FEEDBACK
// ==========================================

model Customer {
  id              String               @id @default(uuid())
  branchId        String
  firstName       String
  lastName        String
  phone           String
  email           String?
  loyaltyPoints   Int                  @default(0)
  tier            String               @default("BRONZE") // BRONZE, SILVER, GOLD, PLATINUM
  totalSpent      Decimal              @default(0) @db.Decimal(12, 2)
  visitCount      Int                  @default(0)
  lastVisitAt     DateTime?
  segment         String               @default("REGULAR") // NEW, REGULAR, VIP, AT_RISK
  notes           String?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  branch          Branch               @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders          Order[]
  reservations    Reservation[]
  loyaltyTxs      LoyaltyTransaction[]
  feedbacks       Feedback[]

  @@unique([branchId, phone])
  @@index([branchId])
  @@index([phone])
  @@index([segment])
  @@index([createdAt])
}

model LoyaltyTransaction {
  id          String        @id @default(uuid())
  customerId  String
  orderId     String?
  type        LoyaltyTxType
  points      Int
  balanceAfter Int
  description String?
  createdBy   String?
  createdAt   DateTime      @default(now())

  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([orderId])
  @@index([createdAt])
}

model Feedback {
  id          String   @id @default(uuid())
  branchId    String
  orderId     String?
  customerId  String?
  rating      Int      // 1 to 5
  foodRating  Int?
  serviceRating Int?
  comment     String?
  isResolved  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order       Order?    @relation(fields: [orderId], references: [id])
  customer    Customer? @relation(fields: [customerId], references: [id])

  @@index([branchId])
  @@index([orderId])
  @@index([customerId])
  @@index([rating])
}

// ==========================================
// INVENTORY, RECIPES, WASTAGE & SUPPLIERS
// ==========================================

model Ingredient {
  id                String             @id @default(uuid())
  branchId          String
  sku               String
  name              String
  unit              String             // kg, g, l, ml, pcs
  currentStock      Decimal            @default(0) @db.Decimal(12, 3)
  reorderLevel      Decimal            @default(10) @db.Decimal(12, 3)
  costPerUnit       Decimal            @default(0) @db.Decimal(10, 2)
  expiryDate        DateTime?
  isActive          Boolean            @default(true)
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  deletedAt         DateTime?

  branch            Branch             @relation(fields: [branchId], references: [id], onDelete: Cascade)
  recipeIngredients RecipeIngredient[]
  stockMovements    StockMovement[]
  wastageLogs       WastageLog[]
  poItems           PurchaseOrderItem[]

  @@unique([branchId, sku])
  @@index([branchId])
  @@index([sku])
  @@index([currentStock])
}

model Recipe {
  id          String             @id @default(uuid())
  menuItemId  String             @unique
  instructions String?
  yieldQty    Int                @default(1)
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  menuItem    MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredients RecipeIngredient[]

  @@index([menuItemId])
}

model RecipeIngredient {
  id           String     @id @default(uuid())
  recipeId     String
  ingredientId String
  quantity     Decimal    @db.Decimal(10, 3)

  recipe       Recipe     @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@unique([recipeId, ingredientId])
  @@index([recipeId])
  @@index([ingredientId])
}

model StockMovement {
  id            String            @id @default(uuid())
  branchId      String
  ingredientId  String
  type          StockMovementType
  quantity      Decimal           @db.Decimal(12, 3)
  previousStock Decimal           @db.Decimal(12, 3)
  newStock      Decimal           @db.Decimal(12, 3)
  unitCost      Decimal?          @db.Decimal(10, 2)
  referenceId   String?           // OrderId, POId, etc.
  notes         String?
  createdBy     String?
  createdAt     DateTime          @default(now())

  ingredient    Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([ingredientId])
  @@index([type])
  @@index([createdAt])
}

model WastageLog {
  id           String     @id @default(uuid())
  branchId     String
  ingredientId String
  quantity     Decimal    @db.Decimal(12, 3)
  costLoss     Decimal    @db.Decimal(10, 2)
  reason       String
  reportedBy   String?
  createdAt    DateTime   @default(now())

  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([ingredientId])
  @@index([createdAt])
}

model Supplier {
  id              String            @id @default(uuid())
  branchId        String
  name            String
  contactPerson   String?
  phone           String
  email           String?
  address         String?
  taxId           String?
  balanceDue      Decimal           @default(0) @db.Decimal(12, 2)
  isActive        Boolean           @default(true)
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  deletedAt       DateTime?

  branch          Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  purchaseOrders  PurchaseOrder[]
  payments        SupplierPayment[]

  @@index([branchId])
  @@index([isActive])
}

model PurchaseOrder {
  id             String              @id @default(uuid())
  branchId       String
  supplierId     String
  poNumber       String              @unique
  status         PurchaseOrderStatus @default(DRAFT)
  totalAmount    Decimal             @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal             @default(0) @db.Decimal(12, 2)
  expectedDate   DateTime?
  notes          String?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  deletedAt      DateTime?

  branch         Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  supplier       Supplier            @relation(fields: [supplierId], references: [id])
  items          PurchaseOrderItem[]
  goodsReceipts  GoodsReceipt[]

  @@index([branchId])
  @@index([supplierId])
  @@index([status])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  ingredientId    String
  orderedQty      Decimal       @db.Decimal(12, 3)
  receivedQty     Decimal       @default(0) @db.Decimal(12, 3)
  unitCost        Decimal       @db.Decimal(10, 2)
  subtotal        Decimal       @db.Decimal(12, 2)

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  ingredient      Ingredient    @relation(fields: [ingredientId], references: [id])

  @@index([purchaseOrderId])
  @@index([ingredientId])
}

model GoodsReceipt {
  id              String        @id @default(uuid())
  purchaseOrderId String
  grnNumber       String        @unique
  receivedBy      String?
  itemsReceived   Json          // [{ ingredientId, receivedQty, batchNo, expiryDate }]
  notes           String?
  receivedAt      DateTime      @default(now())
  createdAt       DateTime      @default(now())

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@index([receivedAt])
}

model SupplierPayment {
  id              String   @id @default(uuid())
  branchId        String
  supplierId      String
  purchaseOrderId String?
  amount          Decimal  @db.Decimal(12, 2)
  method          PaymentMethod
  referenceNo     String?
  notes           String?
  paidAt          DateTime @default(now())
  createdBy       String?
  createdAt       DateTime @default(now())

  supplier        Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([supplierId])
  @@index([paidAt])
}

// ==========================================
// STAFF, SHIFTS, ATTENDANCE, LEAVE & PAYROLL
// ==========================================

model Employee {
  id             String         @id @default(uuid())
  branchId       String
  userId         String         @unique
  employeeCode   String         @unique
  designation    String
  department     String         @default("OPERATIONS")
  baseSalary     Decimal        @db.Decimal(12, 2)
  hourlyRate     Decimal        @default(0) @db.Decimal(10, 2)
  joinDate       DateTime       @default(now())
  emergencyPhone String?
  bankAccountNo  String?
  isActive       Boolean        @default(true)
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  shifts         Shift[]
  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  payrolls       Payroll[]

  @@index([branchId])
  @@index([employeeCode])
}

model Shift {
  id         String   @id @default(uuid())
  branchId   String
  employeeId String
  name       String   // Morning, Evening, Night
  startTime  DateTime
  endTime    DateTime
  notes      String?
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([employeeId])
  @@index([startTime])
}

model Attendance {
  id           String    @id @default(uuid())
  branchId     String
  employeeId   String
  clockIn      DateTime
  clockOut     DateTime?
  hoursWorked  Decimal?  @db.Decimal(6, 2)
  overtimeHours Decimal? @default(0) @db.Decimal(6, 2)
  status       String    @default("PRESENT") // PRESENT, LATE, HALF_DAY
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  employee     Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([employeeId])
  @@index([clockIn])
}

model LeaveRequest {
  id         String      @id @default(uuid())
  branchId   String
  employeeId String
  leaveType  String      // SICK, CASUAL, ANNUAL, UNPAID
  startDate  DateTime
  endDate    DateTime
  reason     String
  status     LeaveStatus @default(PENDING)
  approvedBy String?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([employeeId])
  @@index([status])
}

model Payroll {
  id            String   @id @default(uuid())
  branchId      String
  employeeId    String
  periodMonth   Int      // 1-12
  periodYear    Int      // e.g. 2026
  baseSalary    Decimal  @db.Decimal(12, 2)
  overtimePay   Decimal  @default(0) @db.Decimal(10, 2)
  tipsShare     Decimal  @default(0) @db.Decimal(10, 2)
  bonuses       Decimal  @default(0) @db.Decimal(10, 2)
  deductions    Decimal  @default(0) @db.Decimal(10, 2)
  netPay        Decimal  @db.Decimal(12, 2)
  status        String   @default("GENERATED") // GENERATED, PAID
  paidAt        DateTime?
  createdBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employee      Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, periodMonth, periodYear])
  @@index([branchId])
  @@index([employeeId])
}

// ==========================================
// EXPENSES & ACCOUNTING
// ==========================================

model ExpenseCategory {
  id          String    @id @default(uuid())
  branchId    String
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  expenses    Expense[]

  @@index([branchId])
}

model Expense {
  id          String          @id @default(uuid())
  branchId    String
  categoryId  String
  title       String
  amount      Decimal         @db.Decimal(12, 2)
  method      PaymentMethod   @default(CASH)
  receiptUrl  String?
  incurredAt  DateTime        @default(now())
  notes       String?
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  branch      Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category    ExpenseCategory @relation(fields: [categoryId], references: [id])

  @@index([branchId])
  @@index([categoryId])
  @@index([incurredAt])
}

// ==========================================
// DELIVERY ZONES, RIDERS & DELIVERIES
// ==========================================

model DeliveryZone {
  id              String     @id @default(uuid())
  branchId        String
  name            String
  deliveryFee     Decimal    @db.Decimal(10, 2)
  minOrderAmount  Decimal    @default(0) @db.Decimal(10, 2)
  estimatedTimeMin Int       @default(30)
  isActive        Boolean    @default(true)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  branch          Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  deliveries      Delivery[]

  @@index([branchId])
}

model Rider {
  id          String     @id @default(uuid())
  branchId    String
  name        String
  phone       String
  vehicleNo   String?
  status      String     @default("AVAILABLE") // AVAILABLE, BUSY, OFFLINE
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  branch      Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  deliveries  Delivery[]

  @@index([branchId])
  @@index([status])
}

model Delivery {
  id               String         @id @default(uuid())
  branchId         String
  orderId          String         @unique
  zoneId           String?
  riderId          String?
  customerName     String
  customerPhone    String
  deliveryAddress  String
  deliveryFee      Decimal        @default(0) @db.Decimal(10, 2)
  status           DeliveryStatus @default(PENDING)
  assignedAt       DateTime?
  pickedUpAt       DateTime?
  deliveredAt      DateTime?
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  zone             DeliveryZone?  @relation(fields: [zoneId], references: [id])
  rider            Rider?         @relation(fields: [riderId], references: [id])

  @@index([branchId])
  @@index([orderId])
  @@index([riderId])
  @@index([status])
}

// ==========================================
// NOTIFICATIONS
// ==========================================

model Notification {
  id        String    @id @default(uuid())
  branchId  String
  userId    String?
  type      String    // ORDER_NEW, STOCK_LOW, KITCHEN_READY, SYSTEM
  title     String
  message   String
  data      Json?
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  branch    Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

