# Application
NODE_ENV=development
PORT=5000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5000
API_BASE_URL=http://localhost:5000

# Supabase Database (Prisma)
# Transaction pooler (port 6543, ?pgbouncer=true) used at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Session pooler or direct connection (port 5432) used for Prisma migrations
DIRECT_URL="postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# Supabase Storage (Server-side only; falls back to local disk uploads if omitted)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_placeholder_do_not_expose_to_client

# Authentication (JWT)
JWT_ACCESS_SECRET=replace_with_strong_random_access_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_strong_random_refresh_secret_at_least_32_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Optional Redis (Falls back to in-memory cache & background job runner if empty)
REDIS_URL=

# Initial Seed Admin Credentials
SEED_ADMIN_EMAIL=admin@rms-enterprise.local
SEED_ADMIN_PASSWORD=Admin@123456!

